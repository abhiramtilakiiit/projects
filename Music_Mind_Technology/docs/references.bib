  year      = {1998},
  abstract  = {This study presents a computer-aided method for generating prototypical facial expressions of emotion. The approach minimizes individual physiognomic differences, producing composite images that accurately represent specific emotions. These prototypes are valuable for research in emotion recognition and related fields.}
